{
  "expo": {
    "name": "Captain (development)",
    "slug": "captain-mobile",
    "version": "0.0.1",
    "scheme": "app.askthecaptain.dev",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.askthecaptain.dev",
      "supportsTablet": false
    },
    "android": {
      "package": "app.askthecaptain.dev",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png",
        "backgroundColor": "#f1f5ee"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }]
    ],
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f1f5ee"
    }
  }
}
